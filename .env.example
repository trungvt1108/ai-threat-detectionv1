# Copy to .env (ignored by Git) or export in your shell. Placeholders only.
# Django settings module: config.settings.local | config.settings.test | config.settings.production_template
DJANGO_SETTINGS_MODULE=config.settings.local

# Optional: override the Django secret key. By default `manage.py init_local`
# creates .local/keys/django_secret.key. Never commit a real value.
ATD_SECRET_KEY=change-me-placeholder

# Runtime data directory (DB, normalized events, models, reports). Default: ./.local
ATD_DATA_DIR=

# Explicit roots that sources may read from (os.pathsep separated, i.e. ';' on Windows, ':' on Linux).
# Default allows only project-managed folders under ATD_DATA_DIR (lab, datasets, inbox).
ATD_ALLOWED_SOURCE_ROOTS=

# Resource budgets
ATD_MAX_CPU_THREADS=2
ATD_MAX_LINE_BYTES=65536
ATD_MAX_FILE_BYTES=2147483648
ATD_MAX_EVENTS_PER_JOB=2000000
ATD_IMPORT_CHUNK=2000
ATD_RETENTION_DAYS=30
ATD_MODEL_MAX_AGE_DAYS=90

# Raw identity view in the local console (admin only). Default off.
ATD_ALLOW_RAW_IDENTITY_VIEW=false

# Public identity allowlist for publish_check (comma separated emails/names you chose to publish)
ATD_PUBLIC_IDENTITY_ALLOWLIST=
